# Banco (Neon). DATABASE_URL = connection string com pooler (runtime);
# DIRECT_URL = connection string direta, usada pelo Prisma CLI (migrate/seed).
DATABASE_URL=
DIRECT_URL=

# Auth.js v5 — gere com: npx auth secret (ou: openssl rand -base64 32)
AUTH_SECRET=
# Opcional na Vercel (detecta o host). Em local: http://localhost:3000
AUTH_URL=http://localhost:3000

# Seed (prisma db seed) — nenhuma senha fica no código.
ADMIN_NAME=Administrador Ágora
ADMIN_EMAIL=
ADMIN_PASSWORD=
LEADER1_EMAIL=
LEADER1_PASSWORD=
LEADER2_EMAIL=
LEADER2_PASSWORD=
